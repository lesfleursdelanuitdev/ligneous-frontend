// Prisma Schema for Ligneous Frontend
// Database: PostgreSQL (separate from Go API database)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Users Table
model User {
  id             String    @id @default(uuid()) @db.Uuid
  username       String    @unique @db.VarChar(255)
  email          String    @unique @db.VarChar(255)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  name           String?   @db.VarChar(255)
  isWebsiteOwner Boolean   @default(false) @map("is_website_owner")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  isActive       Boolean   @default(true) @map("is_active")

  // Relations
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  treeOwners             TreeOwner[]
  userIndividualLinks    UserIndividualLink[]
  permissions            Permission[]
  grantedPermissions     Permission[]         @relation("PermissionGrantedBy")
  treeMaintainers        TreeMaintainer[]
  accessRequests         AccessRequest[]
  respondedRequests      AccessRequest[]      @relation("RequestRespondedBy")
  addedMaintainers       TreeMaintainer[]     @relation("MaintainerAddedBy")
  addedOwners            TreeOwner[]          @relation("OwnerAddedBy")
  createdInvitationLinks InvitationLink[]     @relation("InvitationLinksCreated")
  invitationLinkUses     InvitationLinkUse[]  @relation("InvitationLinkUses")
  albums                 Album[]
  albumMedia             AlbumMedia[]         @relation("AlbumMediaAddedBy")
  albumShares            AlbumShare[]
  sharedAlbums           AlbumShare[]         @relation("AlbumSharedBy")
  userTags               Tag[]                @relation("UserTags")
  createdTags            Tag[]                @relation("TagCreator")
  taggedItems            TaggedItem[]         @relation("TaggedBy")

  // Collaboration relations
  comments             Comment[]
  discussionThreads    DiscussionThread[] @relation("ThreadCreator")
  discussionPosts      DiscussionPost[]
  suggestions          Suggestion[]       @relation("SuggestionAuthor")
  reviewedSuggestions  Suggestion[]       @relation("SuggestionReviewer")
  researchNotes        ResearchNote[]
  notebooks            Notebook[]
  sentMessages         Message[]          @relation("SentMessages")
  receivedMessages     Message[]          @relation("ReceivedMessages")
  createdMessageGroups MessageGroup[]
  messageGroupMembers  MessageGroup[]     @relation("GroupMembers")

  // User profile & following
  profile   UserProfile?
  following Follow[]     @relation("Following")
  followers Follow[]     @relation("Followers")

  // Content & feed
  userContent     UserContent[]
  contentLikes    ContentLike[]
  contentComments ContentComment[]
  contentShares   ContentShare[]
  userFeeds       UserFeed[]

  // Notifications & activity
  notifications       Notification[]
  notificationsActed  Notification[] @relation("NotificationActor")
  activities    Activity[]

  // Mentions
  commentMentions Comment[]          @relation("CommentMentions")
  postMentions    DiscussionPost[]   @relation("PostMentions")
  threadWatchers  DiscussionThread[] @relation("ThreadWatchers")

  @@index([email])
  @@index([username])
  @@map("users")
}

// 2. Sessions Table
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  refreshTokenHash String?   @unique @map("refresh_token_hash") @db.VarChar(255)
  refreshExpiresAt DateTime? @map("refresh_expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent") @db.Text
  isRevoked        Boolean   @default(false) @map("is_revoked")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
  @@index([userId, isRevoked, expiresAt])
  @@index([userId, isRevoked, refreshExpiresAt])
  @@map("sessions")
}

// 2a. Password Reset Tokens Table
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(255) // Secure random token
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([userId, expiresAt, usedAt])
  @@map("password_reset_tokens")
}

// 3. Trees Table
model Tree {
  id          String   @id @default(uuid()) @db.Uuid
  fileId      String   @unique @map("file_id") @db.VarChar(255)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  gedcomFileId String?     @unique @map("gedcom_file_id") @db.Uuid
  gedcomFile   GedcomFile? @relation(fields: [gedcomFileId], references: [id], onDelete: SetNull)

  // Relations
  owners              TreeOwner[]
  userIndividualLinks UserIndividualLink[]
  permissions         Permission[]
  treeMaintainers     TreeMaintainer[]
  accessRequests      AccessRequest[]
  privateData         PrivateData[]
  invitationLinks     InvitationLink[]

  // Collaboration relations
  comments          Comment[]
  discussionThreads DiscussionThread[]
  suggestions       Suggestion[]
  researchNotes     ResearchNote[]
  messageGroups     MessageGroup[]
  userContent       UserContent[]
  follows           Follow[]
  activities        Activity[]
  notifications     Notification[]

  @@index([fileId])
  @@index([isPublic])
  @@map("trees")
}

// 3a. Tree Owners Table (Multiple owners per tree)
model TreeOwner {
  id        String   @id @default(uuid()) @db.Uuid
  treeId    String   @map("tree_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  addedBy   String?  @map("added_by") @db.Uuid

  tree  Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  adder User? @relation("OwnerAddedBy", fields: [addedBy], references: [id], onDelete: SetNull)

  @@unique([treeId, userId])
  @@index([treeId])
  @@index([userId])
  @@index([treeId, isPrimary])
  @@map("tree_owners")
}

// 4. User-Individual Links Table
model UserIndividualLink {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  treeId         String   @map("tree_id") @db.Uuid
  individualXref String   @map("individual_xref") @db.VarChar(50)
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@unique([userId, treeId, individualXref])
  @@index([userId])
  @@index([treeId])
  @@index([treeId, individualXref])
  @@index([userId, verified])
  @@map("user_individual_links")
}

// 5. Permissions Table
enum PermissionType {
  read
  write
  delete
  admin
}

enum ResourceType {
  tree
  individual
  family
  subtree
}

enum AccessRequestType {
  basic_access // Request read or write access to tree
  individual_link // "This is me" - link to individual
  maintainer_role // Request to become tree maintainer
  owner_role // Request to become tree owner
}

model Permission {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  treeId         String         @map("tree_id") @db.Uuid
  resourceType   ResourceType   @map("resource_type")
  resourceId     String         @map("resource_id") @db.VarChar(255)
  permissionType PermissionType @map("permission_type")
  grantedBy      String?        @map("granted_by") @db.Uuid
  grantedAt      DateTime       @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt      DateTime?      @map("expires_at") @db.Timestamptz(6)
  notes          String?        @db.Text

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree    Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  granter User? @relation("PermissionGrantedBy", fields: [grantedBy], references: [id])

  @@unique([userId, treeId, resourceType, resourceId, permissionType])
  @@index([userId, treeId])
  @@index([treeId, resourceType, resourceId])
  @@index([expiresAt])
  @@map("permissions")
}

// 6. Tree Maintainers Table
model TreeMaintainer {
  id        String   @id @default(uuid()) @db.Uuid
  treeId    String   @map("tree_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  addedBy   String?  @map("added_by") @db.Uuid

  tree  Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  adder User? @relation("MaintainerAddedBy", fields: [addedBy], references: [id])

  @@unique([treeId, userId])
  @@index([treeId])
  @@index([userId])
  @@map("tree_maintainers")
}

// 7. Access Requests Table
enum AccessRequestStatus {
  pending
  approved
  rejected
  cancelled
}

model AccessRequest {
  id                      String              @id @default(uuid()) @db.Uuid
  userId                  String              @map("user_id") @db.Uuid
  treeId                  String              @map("tree_id") @db.Uuid
  requestType             AccessRequestType   @default(basic_access) @map("request_type")
  resourceType            ResourceType?       @map("resource_type")
  resourceId              String?             @map("resource_id") @db.VarChar(255)
  requestedPermissionType PermissionType?     @map("requested_permission_type")
  status                  AccessRequestStatus @default(pending)
  notes                   String?             @db.Text
  responseNotes           String?             @map("response_notes") @db.Text
  requestedAt             DateTime            @default(now()) @map("requested_at") @db.Timestamptz(6)
  respondedAt             DateTime?           @map("responded_at") @db.Timestamptz(6)
  respondedBy             String?             @map("responded_by") @db.Uuid

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree      Tree  @relation(fields: [treeId], references: [id], onDelete: Cascade)
  responder User? @relation("RequestRespondedBy", fields: [respondedBy], references: [id])

  @@index([userId])
  @@index([treeId])
  @@index([requestType, status])
  @@index([status])
  @@index([treeId, status])
  @@map("access_requests")
}

// 8. Private Data Table
model PrivateData {
  id           String       @id @default(uuid()) @db.Uuid
  treeId       String       @map("tree_id") @db.Uuid
  resourceType ResourceType @map("resource_type")
  resourceId   String       @map("resource_id") @db.VarChar(255)
  fieldName    String       @map("field_name") @db.VarChar(255)
  isPrivate    Boolean      @default(true) @map("is_private")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@index([treeId, resourceType, resourceId])
  @@index([treeId])
  @@map("private_data")
}

// 9. Invitation Links Table
model InvitationLink {
  id             String    @id @default(uuid()) @db.Uuid
  token          String    @unique @default(uuid()) @db.Uuid
  treeId         String    @map("tree_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  roleType       String    @map("role_type") @db.VarChar(50) // 'read', 'write', 'maintainer', 'owner'
  individualXref String?   @map("individual_xref") @db.VarChar(50) // Optional: if linking to individual
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  maxUses        Int?      @map("max_uses") // null = unlimited, 1 = one-time
  usedCount      Int       @default(0) @map("used_count")
  isRevoked      Boolean   @default(false) @map("is_revoked")
  notes          String?   @db.Text // Description of link purpose
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tree    Tree                @relation(fields: [treeId], references: [id], onDelete: Cascade)
  creator User                @relation("InvitationLinksCreated", fields: [createdBy], references: [id], onDelete: Cascade)
  uses    InvitationLinkUse[]

  @@index([token])
  @@index([treeId])
  @@index([createdBy])
  @@index([isRevoked, expiresAt])
  @@map("invitation_links")
}

// 10. Invitation Link Usage Tracking Table
model InvitationLinkUse {
  id        String   @id @default(uuid()) @db.Uuid
  linkId    String   @map("link_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  usedAt    DateTime @default(now()) @map("used_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address") @db.Inet

  link InvitationLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user User           @relation("InvitationLinkUses", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([linkId, userId])
  @@index([linkId])
  @@index([userId])
  @@map("invitation_link_uses")
}

// 11. Albums Table
model Album {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  coverMediaId String?  @map("cover_media_id") @db.VarChar(255) // UUID from Go API
  isPublic     Boolean  @default(false) @map("is_public")
  sortOrder    Int      @default(0) @map("sort_order") // For user's album ordering
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  albumMedia  AlbumMedia[]
  albumShares AlbumShare[]

  @@index([userId])
  @@index([userId, isPublic])
  @@map("albums")
}

// 12. Album-Media Junction Table
model AlbumMedia {
  id        String   @id @default(uuid()) @db.Uuid
  albumId   String   @map("album_id") @db.Uuid
  fileId    String   @map("file_id") @db.VarChar(255) // Go API file_id
  mediaId   String   @map("media_id") @db.VarChar(255) // Go API media UUID
  sortOrder Int      @default(0) @map("sort_order") // Order within album
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  addedBy   String?  @map("added_by") @db.Uuid // User who added it

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  adder User? @relation("AlbumMediaAddedBy", fields: [addedBy], references: [id], onDelete: SetNull)

  @@unique([albumId, fileId, mediaId]) // Prevent duplicates
  @@index([albumId])
  @@index([fileId, mediaId]) // For finding which albums contain a media
  @@map("album_media")
}

// 13. Album Sharing Table
model AlbumShare {
  id       String   @id @default(uuid()) @db.Uuid
  albumId  String   @map("album_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  canEdit  Boolean  @default(false) @map("can_edit")
  sharedAt DateTime @default(now()) @map("shared_at") @db.Timestamptz(6)
  sharedBy String   @map("shared_by") @db.Uuid

  album  Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharer User  @relation("AlbumSharedBy", fields: [sharedBy], references: [id], onDelete: Cascade)

  @@unique([albumId, userId])
  @@index([albumId])
  @@index([userId])
  @@map("album_shares")
}

// 14. Tags Table (supports both global and user-specific)
model Tag {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid // null = global tag, set = user tag
  name        String   @db.VarChar(100)
  color       String?  @db.VarChar(7) // Hex color for UI
  description String?  @db.Text
  isGlobal    Boolean  @default(false) @map("is_global") // Explicit flag for clarity
  createdBy   String?  @map("created_by") @db.Uuid // Who created it (for global tags, could be admin)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User?        @relation("UserTags", fields: [userId], references: [id], onDelete: Cascade)
  creator User?        @relation("TagCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items   TaggedItem[]

  // Note: Uniqueness constraints handled in application logic:
  // - Global tags: unique by name (only one "Ancestor" tag globally)
  // - User tags: unique by (userId, name) (each user can have their own "Ancestor" tag)
  @@index([userId])
  @@index([isGlobal])
  @@index([isGlobal, name])
  @@index([name]) // For global tag uniqueness check
  @@index([userId, name]) // For user tag uniqueness check
  @@map("tags")
}

// 15. Entity Type Enum (for tagging)
enum EntityType {
  media
  event
  individual
  family
  note
  source
  place
  date
}

// 16. Tagged Items Table (polymorphic - can tag any entity type)
model TaggedItem {
  id         String     @id @default(uuid()) @db.Uuid
  tagId      String     @map("tag_id") @db.Uuid
  taggedBy   String     @map("tagged_by") @db.Uuid // User who applied this tag
  entityType EntityType @map("entity_type")
  fileId     String     @map("file_id") @db.VarChar(255) // Go API file_id
  entityId   String     @map("entity_id") @db.VarChar(255) // UUID or XREF
  entityXref String?    @map("entity_xref") @db.VarChar(50) // Optional XREF for convenience
  taggedAt   DateTime   @default(now()) @map("tagged_at") @db.Timestamptz(6)

  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user User @relation("TaggedBy", fields: [taggedBy], references: [id], onDelete: Cascade)

  // Prevent duplicate tagging: same tag applied to same entity by same user
  @@unique([tagId, taggedBy, entityType, fileId, entityId])
  @@index([tagId])
  @@index([taggedBy, entityType, fileId, entityId]) // Find user's tags for an entity
  @@index([entityType, fileId, entityId]) // Find all tags for an entity
  @@index([taggedBy]) // Find all entities tagged by a user
  @@map("tagged_items")
}

// ============================================================================
// COLLABORATION TABLES
// ============================================================================

// 17. Comments Table
model Comment {
  id         String    @id @default(uuid()) @db.Uuid
  entityType String    @map("entity_type") @db.VarChar(50)
  entityId   String    @map("entity_id") @db.VarChar(255)
  treeId     String    @map("tree_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  content    String    @db.Text
  isEdited   Boolean   @default(false) @map("is_edited")
  isResolved Boolean   @default(false) @map("is_resolved")
  isPinned   Boolean   @default(false) @map("is_pinned")
  isHidden   Boolean   @default(false) @map("is_hidden")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree     Tree      @relation(fields: [treeId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[] @relation("CommentReplies")
  mentions User[]    @relation("CommentMentions")

  @@index([entityType, entityId])
  @@index([treeId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

// 18. Discussion Threads Table
model DiscussionThread {
  id          String   @id @default(uuid()) @db.Uuid
  treeId      String?  @map("tree_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  category    String?  @db.VarChar(100)
  tags        String[] // Array of tags (surnames, locations, etc.)
  isLocked    Boolean  @default(false) @map("is_locked")
  isPinned    Boolean  @default(false) @map("is_pinned")
  isClosed    Boolean  @default(false) @map("is_closed")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tree     Tree?            @relation(fields: [treeId], references: [id], onDelete: Cascade)
  creator  User             @relation("ThreadCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  posts    DiscussionPost[]
  watchers User[]           @relation("ThreadWatchers")
  follows  Follow[]

  @@index([treeId])
  @@index([createdBy])
  @@index([category])
  @@index([tags]) // GIN index for array search
  @@map("discussion_threads")
}

// 19. Discussion Posts Table
model DiscussionPost {
  id        String    @id @default(uuid()) @db.Uuid
  threadId  String    @map("thread_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  content   String    @db.Text
  isEdited  Boolean   @default(false) @map("is_edited")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  thread      DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentions    User[]           @relation("PostMentions")
  attachments Media[]          @relation("PostAttachments")

  @@index([threadId])
  @@index([userId])
  @@index([createdAt])
  @@map("discussion_posts")
}

// 20. Suggestions Table
enum SuggestionStatus {
  pending
  approved
  rejected
  needs_info
}

model Suggestion {
  id             String           @id @default(uuid()) @db.Uuid
  entityType     String           @map("entity_type") @db.VarChar(50)
  entityId       String           @map("entity_id") @db.VarChar(255)
  treeId         String           @map("tree_id") @db.Uuid
  fieldName      String           @map("field_name") @db.VarChar(255)
  currentValue   String?          @map("current_value") @db.Text
  suggestedValue String           @map("suggested_value") @db.Text
  evidence       String?          @db.Text
  status         SuggestionStatus @default(pending)
  suggestedBy    String           @map("suggested_by") @db.Uuid
  reviewedBy     String?          @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes    String?          @map("review_notes") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  suggester   User    @relation("SuggestionAuthor", fields: [suggestedBy], references: [id], onDelete: Cascade)
  reviewer    User?   @relation("SuggestionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  tree        Tree    @relation(fields: [treeId], references: [id], onDelete: Cascade)
  attachments Media[] @relation("SuggestionAttachments")

  @@index([entityType, entityId])
  @@index([treeId])
  @@index([status])
  @@index([suggestedBy])
  @@index([reviewedBy])
  @@map("suggestions")
}

// 21. Research Notes Table
model ResearchNote {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(255)
  treeId     String?  @map("tree_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  title      String?  @db.VarChar(255)
  content    String   @db.Text
  isPrivate  Boolean  @default(true) @map("is_private")
  notebookId String?  @map("notebook_id") @db.Uuid
  tags       String[]
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree        Tree?     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  notebook    Notebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  attachments Media[]   @relation("ResearchNoteAttachments")

  @@index([entityType, entityId])
  @@index([treeId])
  @@index([userId])
  @@index([notebookId])
  @@index([tags]) // GIN index for array search
  @@map("research_notes")
}

// 22. Notebooks Table
model Notebook {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isPrivate   Boolean  @default(true) @map("is_private")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes ResearchNote[]

  @@index([userId])
  @@map("notebooks")
}

// 23. Messages Table
model Message {
  id          String    @id @default(uuid()) @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  recipientId String?   @map("recipient_id") @db.Uuid
  groupId     String?   @map("group_id") @db.Uuid
  subject     String?   @db.VarChar(255)
  content     String    @db.Text
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sender      User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User?         @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  group       MessageGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attachments Media[]       @relation("MessageAttachments")

  @@index([senderId])
  @@index([recipientId])
  @@index([groupId])
  @@index([isRead])
  @@index([createdAt])
  @@map("messages")
}

// 24. Message Groups Table
model MessageGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  treeId      String?  @map("tree_id") @db.Uuid
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tree     Tree?     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  creator  User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  members  User[]    @relation("GroupMembers")
  messages Message[]

  @@index([treeId])
  @@index([createdBy])
  @@map("message_groups")
}

