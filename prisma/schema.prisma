// 25. User Profiles Table
enum ProfileVisibility {
  public
  collaborators_only
  private
}

enum ActivityVisibility {
  public
  followers_only
  collaborators_only
  private
}

model UserProfile {
  id              String  @id @default(uuid()) @db.Uuid
  userId          String  @unique @map("user_id") @db.Uuid
  displayName     String? @map("display_name") @db.VarChar(255)
  bio             String? @db.Text
  location        String? @db.VarChar(255)
  profilePhotoUrl String? @map("profile_photo_url") @db.VarChar(500)
  coverPhotoUrl   String? @map("cover_photo_url") @db.VarChar(500)

  // Research interests
  researchSurnames    String[] @map("research_surnames")
  researchLocations   String[] @map("research_locations")
  researchTimePeriods String[] @map("research_time_periods")
  researchGoals       String?  @map("research_goals") @db.Text

  // Genealogy credentials
  yearsResearching Int?     @map("years_researching")
  specializations  String[]
  certifications   String[]
  languages        String[]

  // Privacy settings
  profileVisibility   ProfileVisibility  @default(collaborators_only) @map("profile_visibility")
  activityVisibility  ActivityVisibility @default(collaborators_only) @map("activity_visibility")
  allowDirectMessages Boolean            @default(true) @map("allow_direct_messages")
  allowFollowing      Boolean            @default(true) @map("allow_following")

  // Stats (computed/cached)
  treesOwnedCount      Int @default(0) @map("trees_owned_count")
  treesMaintainedCount Int @default(0) @map("trees_maintained_count")
  contributionsCount   Int @default(0) @map("contributions_count")
  followersCount       Int @default(0) @map("followers_count")
  followingCount       Int @default(0) @map("following_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// 26. Follows Table
model Follow {
  id                 String  @id @default(uuid()) @db.Uuid
  followerId         String  @map("follower_id") @db.Uuid
  followeeId         String? @map("followee_id") @db.Uuid
  treeId             String? @map("tree_id") @db.Uuid
  entityType         String? @map("entity_type") @db.VarChar(50)
  entityId           String? @map("entity_id") @db.VarChar(255)
  discussionThreadId String? @map("discussion_thread_id") @db.Uuid

  isMuted   Boolean  @default(false) @map("is_muted")
  isPrivate Boolean  @default(false) @map("is_private")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  follower User              @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followee User?             @relation("Followers", fields: [followeeId], references: [id], onDelete: Cascade)
  tree     Tree?             @relation(fields: [treeId], references: [id], onDelete: Cascade)
  thread   DiscussionThread? @relation(fields: [discussionThreadId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@unique([followerId, treeId])
  @@unique([followerId, entityType, entityId])
  @@unique([followerId, discussionThreadId])
  @@index([followerId])
  @@index([followeeId])
  @@index([treeId])
  @@map("follows")
}

// ============================================================================
// CONTENT & FEED TABLES
// ============================================================================

// 27. User Content Table
enum ContentType {
  research_update
  family_story
  research_discovery
  collaboration_request
  recipe
  research_log
}

enum ContentVisibility {
  public
  followers_only
  collaborators_only
  private
}

model UserContent {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  contentType ContentType       @map("content_type")
  title       String?           @db.VarChar(255)
  content     String            @db.Text
  isPublic    Boolean           @default(false) @map("is_public")
  visibility  ContentVisibility @default(followers_only)

  // Links to related entities
  treeId     String? @map("tree_id") @db.Uuid
  entityType String? @map("entity_type") @db.VarChar(50)
  entityId   String? @map("entity_id") @db.VarChar(255)

  // Tags for organization
  surnames    String[]
  locations   String[]
  timePeriods String[] @map("time_periods")

  // Engagement (cached)
  likesCount    Int @default(0) @map("likes_count")
  commentsCount Int @default(0) @map("comments_count")
  sharesCount   Int @default(0) @map("shares_count")

  // Recipe-specific
  recipeIngredients  String? @map("recipe_ingredients") @db.Text
  recipeInstructions String? @map("recipe_instructions") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree            Tree?            @relation(fields: [treeId], references: [id], onDelete: Cascade)
  media           Media[]          @relation("ContentMedia")
  likes           ContentLike[]
  contentComments ContentComment[]
  shares          ContentShare[]
  userFeeds       UserFeed[]

  @@index([userId])
  @@index([contentType])
  @@index([treeId])
  @@index([isPublic])
  @@index([createdAt])
  @@index([surnames]) // GIN index for array search
  @@index([locations]) // GIN index for array search
  @@index([timePeriods]) // GIN index for array search
  @@map("user_content")
}

// 28. Content Likes Table
model ContentLike {
  id        String   @id @default(uuid()) @db.Uuid
  contentId String   @map("content_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  content UserContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contentId, userId])
  @@index([contentId])
  @@index([userId])
  @@map("content_likes")
}

// 29. Content Comments Table
model ContentComment {
  id        String    @id @default(uuid()) @db.Uuid
  contentId String    @map("content_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  content   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  userContent UserContent      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      ContentComment?  @relation("ContentCommentReplies", fields: [parentId], references: [id])
  replies     ContentComment[] @relation("ContentCommentReplies")

  @@index([contentId])
  @@index([userId])
  @@index([parentId])
  @@map("content_comments")
}

// 30. Content Shares Table
model ContentShare {
  id         String   @id @default(uuid()) @db.Uuid
  contentId  String   @map("content_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  sharedWith String?  @map("shared_with") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  content UserContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([userId])
  @@map("content_shares")
}

// 31. User Feeds Table
model UserFeed {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  contentId  String    @map("content_id") @db.Uuid
  sourceType String    @map("source_type") @db.VarChar(50)
  sourceId   String    @map("source_id") @db.VarChar(255)
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content UserContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([contentId])
  @@index([sourceType, sourceId])
  @@map("user_feeds")
}

// ============================================================================
// NOTIFICATION & ACTIVITY TABLES
// ============================================================================

// 32. Notifications Table
enum NotificationType {
  comment
  reply
  mention
  suggestion
  message
  access_request
  activity
  system
  follow
  content_like
  content_comment
  content_share
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String           @db.Text
  link      String?          @db.VarChar(500)
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // Related entity context (optional)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(255)
  treeId     String?  @map("tree_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  tree  Tree? @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

// 33. Activities Table
model Activity {
  id           String   @id @default(uuid()) @db.Uuid
  activityType String   @map("activity_type") @db.VarChar(100)
  entityType   String?  @map("entity_type") @db.VarChar(50)
  entityId     String?  @map("entity_id") @db.VarChar(255)
  treeId       String   @map("tree_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  description  String   @db.Text
  metadata     Json? // Additional data (before/after values, etc.)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree Tree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@index([treeId])
  @@index([userId])
  @@index([activityType])
  @@index([createdAt])
  @@map("activities")
}

// ============================================================================
// SUPPORTING JUNCTION TABLES
// ============================================================================

// Note: Media model needs to be added if it doesn't exist
// For now, we'll create a placeholder or reference existing media from Go API
// Media relations are stored as fileId + mediaId (UUIDs from Go API)

// Media junction table for attachments (polymorphic)
model Media {
  id         String   @id @default(uuid()) @db.Uuid
  fileId     String   @map("file_id") @db.VarChar(255)
  mediaId    String   @map("media_id") @db.VarChar(255)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  postAttachments         DiscussionPost[] @relation("PostAttachments")
  suggestionAttachments   Suggestion[]     @relation("SuggestionAttachments")
  researchNoteAttachments ResearchNote[]   @relation("ResearchNoteAttachments")
  messageAttachments      Message[]        @relation("MessageAttachments")
  contentMedia            UserContent[]    @relation("ContentMedia")

  @@index([fileId, mediaId])
  @@index([entityType, entityId])
  @@map("media_attachments")
}

// ============================================================================
// GEDCOM TREE DATA TABLES
// These tables store the actual genealogical data parsed from GEDCOM files.
// They mirror the Go API's PostgreSQL schema (002/003 migrations).
// ============================================================================

enum GedcomSex {
  M
  F
  U
  X
}

enum GedcomDateType {
  EXACT
  ABOUT
  BEFORE
  AFTER
  BETWEEN
  CALCULATED
  ESTIMATED
  FROM_TO
  UNKNOWN
}

// G1. GEDCOM File Registry
model GedcomFile {
  id               String    @id @default(uuid()) @db.Uuid
  fileId           String    @unique @map("file_id") @db.Text
  name             String    @db.Text
  originalFilename String?   @map("original_filename") @db.Text
  gedcomPath       String?   @map("gedcom_path") @db.Text
  individualsCount Int       @default(0) @map("individuals_count")
  familiesCount    Int       @default(0) @map("families_count")
  placesCount      Int       @default(0) @map("places_count")
  datesCount       Int       @default(0) @map("dates_count")
  eventsCount      Int       @default(0) @map("events_count")
  notesCount       Int       @default(0) @map("notes_count")
  sourcesCount     Int       @default(0) @map("sources_count")
  fileSize         BigInt?   @map("file_size")
  checksum         String?   @db.Text
  gedcomVersion    String?   @map("gedcom_version") @db.Text
  charset          String?   @db.Text
  status           String    @default("uploading") @db.Text
  parseErrors      Int       @default(0) @map("parse_errors")
  parseWarnings    Int       @default(0) @map("parse_warnings")
  errorMessage     String?   @map("error_message") @db.Text
  lastAccessedAt   DateTime? @map("last_accessed_at") @db.Timestamptz(6)
  accessCount      BigInt    @default(0) @map("access_count")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  parsedAt         DateTime? @map("parsed_at") @db.Timestamptz(6)

  places       GedcomPlace[]
  dates        GedcomDate[]
  individuals  GedcomIndividual[]
  families     GedcomFamily[]
  events       GedcomEvent[]
  notes        GedcomNote[]
  sources      GedcomSource[]
  repositories GedcomRepository[]
  gedcomMedia  GedcomMedia[]
  surnames     GedcomSurname[]
  givenNames   GedcomGivenName[]
  fileObjects  GedcomFileObject[]
  tree         Tree?

  @@index([status])
  @@index([checksum])
  @@index([createdAt])
  @@map("gedcom_files")
}

// G2. Places
model GedcomPlace {
  id        String   @id @default(uuid()) @db.Uuid
  fileUuid  String   @map("file_uuid") @db.Uuid
  original  String   @db.Text
  name      String?  @db.Text
  county    String?  @db.Text
  state     String?  @db.Text
  country   String?  @db.Text
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  hash      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  file GedcomFile @relation(fields: [fileUuid], references: [id], onDelete: Cascade)

  individualBirthPlaces GedcomIndividual[] @relation("IndiBirthPlace")
  individualDeathPlaces GedcomIndividual[] @relation("IndiDeathPlace")
  familyMarriagePlaces  GedcomFamily[]     @relation("FamMarriagePlace")
  familyDivorcePlaces   GedcomFamily[]     @relation("FamDivorcePlace")
  events                GedcomEvent[]

  @@unique([fileUuid, hash])
  @@index([fileUuid])
  @@index([fileUuid, country])
  @@index([fileUuid, state])
  @@index([fileUuid, name])
  @@map("gedcom_places_v2")
}

// G3. Dates
model GedcomDate {
  id        String         @id @default(uuid()) @db.Uuid
  fileUuid  String         @map("file_uuid") @db.Uuid
  original  String?        @db.Text
  dateType  GedcomDateType @default(EXACT) @map("date_type")
  calendar  String?        @default("GREGORIAN") @db.Text
  year      Int?
  month     Int?
  day       Int?
  endYear   Int?           @map("end_year")
  endMonth  Int?           @map("end_month")
  endDay    Int?           @map("end_day")
  hash      String         @db.Text
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  file GedcomFile @relation(fields: [fileUuid], references: [id], onDelete: Cascade)

  individualBirthDates GedcomIndividual[] @relation("IndiBirthDate")
  individualDeathDates GedcomIndividual[] @relation("IndiDeathDate")
  familyMarriageDates  GedcomFamily[]     @relation("FamMarriageDate")
  familyDivorceDates   GedcomFamily[]     @relation("FamDivorceDate")
  events               GedcomEvent[]

  @@unique([fileUuid, hash])
  @@index([fileUuid])
  @@index([fileUuid, year])
  @@map("gedcom_dates_v2")
}

// G4. Surnames
model GedcomSurname {
  id           String   @id @default(uuid()) @db.Uuid
  fileUuid     String   @map("file_uuid") @db.Uuid
  surname      String   @db.Text
  surnameLower String   @map("surname_lower") @db.Text
  soundex      String?  @db.Text
  metaphone    String?  @db.Text
  frequency    Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  file GedcomFile @relation(fields: [fileUuid], references: [id], onDelete: Cascade)

  individualSurnames GedcomIndividualSurname[]
  familySurnames     GedcomFamilySurname[]

  @@unique([fileUuid, surnameLower])
  @@index([fileUuid])
  @@index([fileUuid, surnameLower])
  @@index([fileUuid, soundex])
  @@index([fileUuid, frequency])
  @@map("gedcom_surnames_v2")
}

// G5. Given Names
model GedcomGivenName {
  id             String   @id @default(uuid()) @db.Uuid
  fileUuid       String   @map("file_uuid") @db.Uuid
  givenName      String   @map("given_name") @db.Text
  givenNameLower String   @map("given_name_lower") @db.Text
  frequency      Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  file GedcomFile @relation(fields: [fileUuid], references: [id], onDelete: Cascade)

  individualGivenNames GedcomIndividualGivenName[]

  @@unique([fileUuid, givenNameLower])
  @@index([fileUuid])
  @@index([fileUuid, givenNameLower])
  @@index([fileUuid, frequency])
  @@map("gedcom_given_names_v2")
}

// G6. Individuals
model GedcomIndividual {
  id                String     @id @default(uuid()) @db.Uuid
  fileUuid          String     @map("file_uuid") @db.Uuid
  xref              String     @db.Text
  fullName          String?    @map("full_name") @db.Text
  fullNameLower     String?    @map("full_name_lower") @db.Text
  sex               GedcomSex?
  birthDateId       String?    @map("birth_date_id") @db.Uuid
  birthPlaceId      String?    @map("birth_place_id") @db.Uuid
  birthDateDisplay  String?    @map("birth_date_display") @db.Text
  birthPlaceDisplay String?    @map("birth_place_display") @db.Text
  birthYear         Int?       @map("birth_year")
  deathDateId       String?    @map("death_date_id") @db.Uuid
  deathPlaceId      String?    @map("death_place_id") @db.Uuid
  deathDateDisplay  String?    @map("death_date_display") @db.Text
  deathPlaceDisplay String?    @map("death_place_display") @db.Text
  deathYear         Int?       @map("death_year")
  isLiving          Boolean    @default(true) @map("is_living")
  hasParents        Boolean    @default(false) @map("has_parents")
  hasChildren       Boolean    @default(false) @map("has_children")
  hasSpouse         Boolean    @default(false) @map("has_spouse")
