  @@index([sourceId])
  @@index([repositoryId])
  @@map("gedcom_source_repositories_v2")
}

// G32. XREF Router Table
model GedcomFileObject {
  id         String   @id @default(uuid()) @db.Uuid
  fileUuid   String   @map("file_uuid") @db.Uuid
  xref       String   @db.Text
  objectType String   @map("object_type") @db.Text
  objectUuid String   @map("object_uuid") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  file GedcomFile @relation(fields: [fileUuid], references: [id], onDelete: Cascade)

  @@unique([fileUuid, xref])
  @@index([fileUuid])
  @@index([fileUuid, xref])
  @@index([fileUuid, objectType])
  @@map("gedcom_file_objects")
}
