{
  "name": "ligneous-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint",
    "test": "vitest run --exclude '**/*.integration.test.js'",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --exclude '**/*.integration.test.js'",
    "test:integration": "vitest run mycelia/facets/__tests__/*.integration.test.js",
    "test:integration:verbose": "vitest run mycelia/facets/__tests__/*.integration.test.js --reporter=verbose",
    "db:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@types/d3": "^7.4.3",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cookie": "^1.1.1",
    "d3": "^7.9.0",
    "daisyui": "^5.5.18",
    "jsonwebtoken": "^9.0.3",
    "konva": "^10.2.0",
    "lucide-react": "^0.574.0",
    "motion": "^12.34.3",
    "mycelia-kernel-plugin": "^1.6.0",
    "next": "16.1.4",
    "pg": "^8.17.2",
    "prisma": "^7.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-konva": "^19.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@vitest/ui": "^4.0.18",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "node-fetch": "^2.7.0",
    "tailwindcss": "^4",
    "vitest": "^4.0.18"
  }
